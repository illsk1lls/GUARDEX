<UserControl x:Class="Guardex.SiteBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="TabRow" Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
      <Button x:Name="NewTabButton" DockPanel.Dock="Right" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
              Width="34" Height="30" Padding="0" Margin="6,0,0,0" ToolTip="New tab" Click="OnNewTab"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="30">
        <ItemsControl x:Name="TabList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Bd" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="4"
                      Margin="0,0,4,0" Padding="8,0,2,0" MouseLeftButtonDown="OnTabDown" MouseDown="OnTabMouse">
                <DockPanel Width="168">
                  <Button DockPanel.Dock="Right" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                          Width="22" Height="22" Padding="0" Margin="4,0,0,0" ToolTip="Close tab"
                          Click="OnCloseTab" Tag="{Binding}"/>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="#273222"/>
                  <Setter TargetName="Bd" Property="BorderBrush" Value="#8FB573"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <DockPanel x:Name="ToolRow" Grid.Row="1" LastChildFill="True" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Back" Click="OnBack"/>
        <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Forward" Click="OnForward"/>
        <Button x:Name="ReloadButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Reload" Click="OnReload"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
        <Button x:Name="StarButton" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Bookmark this page" Click="OnStar"/>
        <Button Content="&#xE71F;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" ToolTip="Zoom out" Click="OnZoomOut"/>
        <TextBlock x:Name="ZoomLabel" Text="100%" Width="44" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#8EA088"/>
        <Button Content="&#xE8A3;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Zoom in" Click="OnZoomIn"/>
        <Button Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Find" Click="OnFindToggle"/>
        <Button x:Name="CallsButton" Content="Calls" Height="28" Padding="10,0" Margin="0,0,4,0" ToolTip="Calls this page makes" Click="OnCallsToggle"/>
        <Button Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="History" Click="OnHistoryToggle"/>
        <Button Content="&#xE896;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Downloads" Click="OnDownloadsToggle"/>
        <Button Content="&#xE749;" FontFamily="Segoe MDL2 Assets" Width="34" Height="28" Padding="0" ToolTip="Print" Click="OnPrint"/>
      </StackPanel>
      <Grid>
        <TextBox x:Name="Address" Height="28" VerticalContentAlignment="Center" Padding="6,0" KeyDown="OnAddressKey" TextChanged="OnAddressChanged" GotFocus="OnAddressFocus" LostFocus="OnAddressFocus"/>
        <TextBlock x:Name="AddressHint" Text="Enter a site" Foreground="#8EA088" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
    </DockPanel>

    <DockPanel x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,6" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Close" Margin="8,0,0,0" Click="OnFindClose"/>
      <Button DockPanel.Dock="Right" Content="Previous" Margin="8,0,0,0" Click="OnFindPrevious"/>
      <Button DockPanel.Dock="Right" Content="Next" Margin="8,0,0,0" Click="OnFindNext"/>
      <TextBlock x:Name="FindCount" DockPanel.Dock="Right" Foreground="#8EA088" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="72"/>
      <TextBox x:Name="FindBox" Height="28" VerticalContentAlignment="Center" KeyDown="OnFindKey" TextChanged="OnFindChanged"/>
    </DockPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="CallsColumn" Width="0"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid x:Name="ViewHost"/>
        <Grid x:Name="HistoryPane" Background="#121611">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="HistoryHint" Text="This browser is separate from your signed-in browser. Passwords are not saved." Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearBookmarks" Margin="8,0,0,0"/>
            <TextBlock Text="BOOKMARKS" Foreground="#8EA088" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox x:Name="BookmarkList" Grid.Row="2" MouseDoubleClick="OnVisitOpen">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Url}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="3" Margin="0,8,0,4">
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearHistory" Margin="8,0,0,0"/>
            <TextBlock Text="HISTORY" Foreground="#8EA088" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox x:Name="HistoryList" Grid.Row="4" MouseDoubleClick="OnVisitOpen">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="#8EA088" Margin="8,0,0,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Url}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
      <Border x:Name="CallsPane" Grid.Column="1" Background="#121611" BorderBrush="#2C3828" BorderThickness="1,0,0,0" Padding="12,0,0,0" Visibility="Collapsed">
        <DockPanel>
          <TextBlock x:Name="CallsSummary" DockPanel.Dock="Top" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8" Text="No page open."/>
          <ListBox x:Name="CallList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Band}" FontFamily="Consolas">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#E0C080"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Band}" Value="block">
                              <Setter Property="Foreground" Value="#E0A0A0"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Kind}" Foreground="#8EA088" FontFamily="Consolas" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Host}" FontFamily="Consolas"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Path}" Foreground="#8EA088" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Why}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <Border x:Name="DownloadPane" Grid.Row="4" Visibility="Collapsed" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" MaxHeight="150">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="DOWNLOADS" Foreground="#8EA088" Margin="0,0,0,6"/>
        <ListBox x:Name="DownloadList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Folder" Margin="8,0,0,0" Click="OnShowDownload" Tag="{Binding}" Visibility="{Binding FolderVisibility}"/>
                  <Button Content="Cancel" Margin="8,0,0,0" Click="OnCancelDownload" Tag="{Binding}" Visibility="{Binding CancelVisibility}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#8EA088"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <DockPanel x:Name="StatusRow" Grid.Row="5" Margin="0,6,0,0">
      <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="#8EA088" Margin="12,0,0,0"/>
      <TextBlock x:Name="StatusLeft" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</UserControl>
