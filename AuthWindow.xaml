<Window x:Class="Guardex.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#121611"
        Foreground="#E4ECDF"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="#121611" BorderBrush="#2C3828" BorderThickness="1">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="40" Background="#1B2119" MouseLeftButtonDown="OnDrag">
        <TextBlock Text="Sign in" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button HorizontalAlignment="Right" Width="46" Height="40" Content="&#xE8BB;" Click="OnCancel"
                Background="Transparent" BorderThickness="0" FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="0" ToolTip="Close"/>
      </Grid>
      <StackPanel Margin="18">
        <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="#8EA088" Margin="0,0,0,14"/>
        <TextBlock Text="Auth mode" Foreground="#8EA088" FontSize="12" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="ModeNone" Content="None" GroupName="AuthMode" IsChecked="True" Checked="OnMode"/>
          <RadioButton x:Name="ModeApi" Content="API" GroupName="AuthMode" Checked="OnMode"/>
          <RadioButton x:Name="ModeNpm" Content="Basic (NPM)" GroupName="AuthMode" Checked="OnMode"/>
        </StackPanel>
        <StackPanel x:Name="ApiPanel" Visibility="Collapsed">
          <TextBlock Text="API token" Foreground="#8EA088" FontSize="12" Margin="0,0,0,4"/>
          <PasswordBox x:Name="KeyBox" Height="28"/>
        </StackPanel>
        <StackPanel x:Name="NpmPanel" Visibility="Collapsed">
          <TextBlock Text="Username" Foreground="#8EA088" FontSize="12" Margin="0,0,0,4"/>
          <TextBox x:Name="UserBox" Height="28" VerticalContentAlignment="Center"/>
          <TextBlock Text="Password" Foreground="#8EA088" FontSize="12" Margin="0,12,0,4"/>
          <PasswordBox x:Name="PassBox" Height="28"/>
        </StackPanel>
        <CheckBox x:Name="RememberBox" Content="Remember on this PC" Margin="0,14,0,0"/>
        <TextBlock x:Name="ErrorLine" TextWrapping="Wrap" Foreground="#E0A0A0" Margin="0,8,0,0"/>
        <DockPanel Margin="0,16,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"/>
          <Button DockPanel.Dock="Right" Content="Connect" Click="OnSignIn" IsDefault="True"/>
        </DockPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
