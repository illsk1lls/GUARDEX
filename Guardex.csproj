<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Setup/**;Guardex.Tunnel/**;Guardex.Browser/**;Guardex.Uninstall/**</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Guardex.Program</StartupObject>
    <RootNamespace>Guardex</RootNamespace>
    <AssemblyName>Guardex</AssemblyName>
    <ApplicationTitle>GUARDEX</ApplicationTitle>
    <Version>0.6.3</Version>
    <ApplicationIcon>assets\guardex.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\guardex.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
  </ItemGroup>
</Project>
