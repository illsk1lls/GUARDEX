<Window x:Class="Guardex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GUARDEX"
        Width="980" Height="660"
        MinWidth="760" MinHeight="480"
        Background="#121611"
        Foreground="#E4ECDF"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="GUARDEX" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="#8EA088" Margin="0,6,0,8"/>
      <TextBlock x:Name="Status" FontFamily="Consolas" Foreground="#8EA088"/>
    </StackPanel>
    <TextBox x:Name="Feed" DockPanel.Dock="Bottom" Height="120" Margin="0,12,0,0" IsReadOnly="True"
             Background="#1B2119" Foreground="#8EA088" BorderBrush="#2C3828" FontFamily="Consolas"
             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.3*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="SOURCES" Foreground="#8EA088" Margin="0,0,0,8"/>
        <ListBox x:Name="Sources" Background="#1B2119" BorderBrush="#2C3828" Foreground="#E4ECDF"
                 SelectionChanged="OnSelect">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock Text="{Binding Src}" FontFamily="Consolas" Width="150"/>
                <TextBlock Text="{Binding Band}" FontFamily="Consolas" Width="90"/>
                <TextBlock Text="{Binding Score}" FontFamily="Consolas" Width="40"/>
                <TextBlock Text="{Binding Cycle}" FontFamily="Consolas" Foreground="#8EA088"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="SELECTED" Foreground="#8EA088" Margin="0,0,0,8"/>
        <TextBox x:Name="Detail" IsReadOnly="True" Background="#1B2119" Foreground="#E4ECDF"
                 BorderBrush="#2C3828" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
