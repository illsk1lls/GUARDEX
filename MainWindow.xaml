<Window x:Class="Guardex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GUARDEX"
        Width="1040" Height="720"
        MinWidth="840" MinHeight="560"
        Background="#121611"
        Foreground="#E4ECDF"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnStateChanged"
        Closing="OnClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="Themes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="#1B2119"/>
      <Setter Property="BorderBrush" Value="#2C3828"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#6B3030"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#1B2119"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderBrush" Value="#2C3828"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#222A20"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#314232"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Height="40">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Path Width="18" Height="22" Stretch="Fill" Fill="#8FB573" Data="M9,0 L18,3.5 L16.5,12 L9,22 L1.5,12 L0,3.5 Z" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Text="GUARDEX" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Text="This machine" Foreground="#8EA088" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnWindowClose" ToolTip="Close"/>
      </StackPanel>
    </Grid>
    <StackPanel DockPanel.Dock="Top" Margin="18,8,18,12">
      <StackPanel Orientation="Horizontal">
        <Border Style="{StaticResource Chip}"><TextBlock x:Name="TcpChip"/></Border>
        <Border Style="{StaticResource Chip}"><TextBlock x:Name="HttpChip"/></Border>
        <Border Style="{StaticResource Chip}"><TextBlock x:Name="ListenChip"/></Border>
      </StackPanel>
      <DockPanel Margin="0,12,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="EnforceState" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#8EA088"/>
          <Button x:Name="EnforceButton" Content="Block new connections" Click="OnEnforce"/>
        </StackPanel>
        <StackPanel>
          <TextBlock x:Name="ModelLine" Text="Model: none" FontSize="14"/>
          <TextBlock x:Name="ModelState" Text="status: not ready" Foreground="#8EA088" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
      <Border x:Name="AskBar" Visibility="Collapsed" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Content="Yes" Click="OnAskYes" Margin="0,0,8,0"/>
            <Button Content="No" Click="OnAskNo"/>
          </StackPanel>
          <TextBlock x:Name="AskText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <DockPanel Margin="0,8,0,0" LastChildFill="True">
        <Button x:Name="ConnectButton" DockPanel.Dock="Right" Content="Connect" Click="OnConnect" Margin="8,0,0,0"/>
        <TextBox x:Name="Endpoint" Height="28" VerticalContentAlignment="Center" Padding="6,0" LostFocus="OnEndpointLostFocus"/>
      </DockPanel>
    </StackPanel>

    <Border x:Name="RemoteBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#3A2424" CornerRadius="6" Padding="10,8" Margin="18,0,18,12">
      <TextBlock x:Name="RemoteBannerText" TextWrapping="Wrap" Foreground="#F0C9C9"/>
    </Border>

    <StackPanel DockPanel.Dock="Left" Width="148" Margin="18,0,14,18">
      <Button x:Name="NavTraffic" Content="Traffic" Click="OnNav" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavBlocks" Content="Blocks" Click="OnNav" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavHost" Content="Host" Click="OnNav" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavRemote" Content="Remote" Click="OnNav" Margin="0,0,0,6" HorizontalContentAlignment="Left"/>
      <Button x:Name="NavSite" Content="Site" Click="OnNav" HorizontalContentAlignment="Left"/>
    </StackPanel>

    <Grid Margin="0,0,18,18">
    <Grid x:Name="TrafficPage">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="132"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.25*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="SOURCES" Foreground="#8EA088" Margin="0,0,0,8"/>
          <TextBlock x:Name="PortsLine" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#8EA088" TextWrapping="Wrap"/>
          <ListBox x:Name="Sources" SelectionChanged="OnSelect">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Score}" FontFamily="Consolas" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="84">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#243024"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Band}" Value="block"><Setter Property="Background" Value="#5A3030"/></DataTrigger>
                          <DataTrigger Binding="{Binding Band}" Value="challenge"><Setter Property="Background" Value="#5A4528"/></DataTrigger>
                          <DataTrigger Binding="{Binding Band}" Value="watch"><Setter Property="Background" Value="#4A4528"/></DataTrigger>
                          <DataTrigger Binding="{Binding Band}" Value="allow"><Setter Property="Background" Value="#2C3A2C"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Band}" FontFamily="Consolas"/>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Src}" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding Cycle}" Foreground="#8EA088" FontFamily="Consolas" FontSize="12"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="SELECTED" Foreground="#8EA088" Margin="0,0,0,8"/>
          <TextBox x:Name="Detail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,12,0,0">
        <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Foreground="#8EA088" Margin="0,0,0,8"/>
        <TextBox x:Name="Feed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Grid>

    <Grid x:Name="BlocksPage" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#8EA088" Margin="0,0,0,8"
                   Text="A block lasts a short time, then longer if the source comes back. Rules clear when GUARDEX exits."/>
        <ListBox x:Name="Blocks" SelectionChanged="OnBlockSelect">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Until}" FontFamily="Consolas" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="{Binding Src}" FontFamily="Consolas"/>
                  <TextBlock Foreground="#8EA088" FontSize="12">
                    <Run Text="{Binding State}"/><Run Text="  "/><Run Text="{Binding Origin}"/><Run Text="  "/><Run Text="{Binding Scenario}"/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <Button DockPanel.Dock="Bottom" Content="Release" Click="OnRelease" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <TextBlock DockPanel.Dock="Top" Text="BLOCK" Foreground="#8EA088" Margin="0,0,0,8"/>
        <TextBox x:Name="BlockDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Grid>

    <Grid x:Name="HostPage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="PostureStatus" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.25*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="START ITEMS" Foreground="#8EA088" Margin="0,0,0,8"/>
          <ListBox x:Name="Findings" SelectionChanged="OnFindingSelect">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="64">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#4A4528"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Severity}" Value="block"><Setter Property="Background" Value="#5A3030"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Severity}" FontFamily="Consolas"/>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Kind}" Foreground="#8EA088" FontSize="12"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="DETAIL" Foreground="#8EA088" Margin="0,0,0,8"/>
          <TextBox x:Name="HostDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>
    </Grid>

    <Grid x:Name="RemotePage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="RemoteHead" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#8EA088" Margin="0,0,0,8"
                 Text="None of these are allowed until you check them. A checked tool is left alone. The list is the whole match. A normal program is not on it. A full-screen fake update is how some of these tools hide, so GUARDEX watches the tool."/>
      <DockPanel Grid.Row="2" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="Allow none" Click="OnAllowNone"/>
        <CheckBox x:Name="StopUnlisted" Content="Stop unlisted tools" IsChecked="True" Click="OnStopToggle" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="RemoteStatus" Grid.Row="2" Margin="0,28,0,0" Foreground="#E0C080" TextWrapping="Wrap"/>
      <ListBox x:Name="RemoteList" Grid.Row="3">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding Allowed, Mode=TwoWay}" Click="OnAllowClick" FontSize="14"/>
                <TextBlock Text="{Binding Line}" Foreground="#8EA088" TextWrapping="Wrap" Margin="22,2,8,0"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding State}" HorizontalAlignment="Right" FontFamily="Consolas">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#8EA088"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Stopped"><Setter Property="Foreground" Value="#E0A0A0"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Needs admin"><Setter Property="Foreground" Value="#E0C080"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Foreground" Value="#E0A0A0"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Watching"><Setter Property="Foreground" Value="#E0C080"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Allowed"><Setter Property="Foreground" Value="#8FB573"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid x:Name="SitePage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock TextWrapping="Wrap" Foreground="#8EA088" Margin="0,0,0,8"
                 Text="This opens the page in a separate browser, not your signed-in one, and lists the calls the page makes. A third-party script is shown. A script that then calls a different host is marked. Form data and response bodies are not read."/>
      <DockPanel Grid.Row="1" Margin="0,0,0,8">
        <Button x:Name="SiteButton" DockPanel.Dock="Right" Content="Open" Click="OnSiteOpen" Margin="8,0,0,0"/>
        <TextBox x:Name="SiteUrl" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
      </DockPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.05*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
          <TextBlock x:Name="SiteStatus" DockPanel.Dock="Top" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8" Text="No page open."/>
          <ListBox x:Name="SiteLinks">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Band}" FontFamily="Consolas">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#E0C080"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Band}" Value="block">
                              <Setter Property="Foreground" Value="#E0A0A0"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Kind}" Foreground="#8EA088" FontFamily="Consolas" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Host}" FontFamily="Consolas"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Path}" Foreground="#8EA088" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Why}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="2" Background="#0E120D" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="4">
          <wv2:WebView2 x:Name="SiteView"/>
        </Border>
      </Grid>
    </Grid>
    </Grid>
  </DockPanel>
</Window>
