<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Guardex.Browser.Program</StartupObject>
    <RootNamespace>Guardex.Browser</RootNamespace>
    <AssemblyName>GuardexBrowser</AssemblyName>
    <ApplicationTitle>GUARDEX Browser</ApplicationTitle>
    <Version>0.6.8</Version>
    <ApplicationIcon>..\assets\guardex-browser.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\guardex-browser.ico">
      <Link>guardex-browser.ico</Link>
    </Resource>
    <ProjectReference Include="..\Guardex.Tunnel\Guardex.Tunnel.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\Themes.xaml">
      <Link>Themes.xaml</Link>
    </Page>
  </ItemGroup>
</Project>
