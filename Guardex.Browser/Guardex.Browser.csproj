<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>Guardex.Browser.Program</StartupObject>
    <RootNamespace>Guardex.Browser</RootNamespace>
    <AssemblyName>GuardexBrowser</AssemblyName>
    <ApplicationTitle>GUARDEX Browser</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Guardex.Tunnel\Guardex.Tunnel.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\Themes.xaml">
      <Link>Themes.xaml</Link>
    </Page>
  </ItemGroup>
</Project>
