<UserControl x:Class="Guardex.SiteBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Background="#121611" Focusable="True">
  <UserControl.Resources>
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaption" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#6B3030"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource MenuItem}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>
    <Style x:Key="Omnibox" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="CaretBrush" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="SelectionBrush" Value="#3F6B45"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Margin="14,0,40,0" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="TabRow" Grid.Row="0" LastChildFill="True" Background="#0C100B">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize"/>
        <Button Style="{StaticResource CloseCaption}" Content="&#xE8BB;" Click="OnWindowClose" ToolTip="Close"/>
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,6,0,0">
        <StackPanel Orientation="Horizontal">
          <ItemsControl x:Name="TabList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8,8,0,0" Margin="0,0,2,0" Padding="10,0,2,0"
                        MouseLeftButtonDown="OnTabDown" MouseDown="OnTabMouse"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                  <DockPanel Width="180" Height="34">
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                            Width="22" Height="22" Padding="0" Margin="4,0,2,0" ToolTip="Close tab"
                            Style="{StaticResource IconButton}" Click="OnCloseTab" Tag="{Binding}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#121611"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="NewTabButton" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="12"
                  ToolTip="New tab" Click="OnNewTab" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <Grid x:Name="ToolRow" Grid.Row="1" Margin="6,4,6,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back" Click="OnBack"/>
        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Forward" Click="OnForward"/>
        <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Click="OnReload"/>
        <Button x:Name="HomeButton" Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Home" Click="OnHome"/>
      </StackPanel>
      <Grid x:Name="AddressHost" Grid.Column="1" Margin="4,0">
        <Border Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="18" Height="36"/>
        <TextBox x:Name="Address" Style="{StaticResource Omnibox}" Height="36"
                 VerticalContentAlignment="Center" PreviewKeyDown="OnAddressKey" TextChanged="OnAddressChanged"
                 GotFocus="OnAddressFocus" LostFocus="OnAddressFocus"
                 PreviewMouseLeftButtonDown="OnAddressMouseDown" PreviewMouseLeftButtonUp="OnAddressMouseUp"/>
        <TextBlock x:Name="AddressHint" Text="Enter a site" Foreground="#8EA088" Margin="16,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Button x:Name="StarButton" Style="{StaticResource IconButton}" Content="&#xE734;" HorizontalAlignment="Right"
                Margin="0,0,2,0" ToolTip="Bookmark this page" Click="OnStar"/>
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="36" Height="36">
          <Button x:Name="DownloadsButton" Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Downloads" ClickMode="Press" Click="OnDownloadsToggle"/>
          <Ellipse x:Name="DownloadTrack" Width="28" Height="28" Stroke="#333333" StrokeThickness="2" IsHitTestVisible="False" Visibility="Collapsed"/>
          <Ellipse x:Name="DownloadArc" Width="28" Height="28" Stroke="#8FB573" StrokeThickness="2"
                   StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" Visibility="Collapsed"
                   RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="DownloadSpin" Angle="-90"/>
            </Ellipse.RenderTransform>
          </Ellipse>
          <Border x:Name="DownloadBadge" Width="16" Height="16" CornerRadius="8" Background="#8FB573"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="DownloadCount" FontSize="9" FontWeight="Bold" Foreground="#121611"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="1"/>
          </Border>
        </Grid>
        <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Menu" Click="OnMenu"/>
      </StackPanel>
    </Grid>

    <Border x:Name="BookBar" Grid.Row="2" Background="#0C100B" BorderBrush="#2C3828" BorderThickness="0,0,0,1" Visibility="Collapsed">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,2">
        <ItemsControl x:Name="BookBarList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Click="OnBookBarOpen" Tag="{Binding}" Height="28" Margin="2,0" Padding="8,0" Cursor="Hand"
                      Background="Transparent" BorderThickness="0" Foreground="#E4ECDF">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#273222"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                  <Grid Width="16" Height="16" Margin="0,0,6,0">
                    <Border Background="#273222" CornerRadius="3"/>
                    <TextBlock Text="{Binding Mark}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                  </Grid>
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel x:Name="FindBar" Grid.Row="3" Visibility="Collapsed" Margin="8,0,8,6" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Close" Margin="8,0,0,0" Click="OnFindClose"/>
      <Button DockPanel.Dock="Right" Content="Previous" Margin="8,0,0,0" Click="OnFindPrevious"/>
      <Button DockPanel.Dock="Right" Content="Next" Margin="8,0,0,0" Click="OnFindNext"/>
      <TextBlock x:Name="FindCount" DockPanel.Dock="Right" Foreground="#8EA088" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="72"/>
      <TextBox x:Name="FindBox" Height="32" VerticalContentAlignment="Center" KeyDown="OnFindKey" TextChanged="OnFindChanged"/>
    </DockPanel>

    <Border x:Name="AskBar" Grid.Row="4" Visibility="Collapsed" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="0,1,0,1" Padding="12,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="AskPhrase" Width="280" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center" Visibility="Collapsed"/>
          <Button x:Name="AskOpen" Content="Open" Margin="8,0,0,0" Click="OnAskOpen"/>
          <Button x:Name="AskSave" Content="Save" Margin="8,0,0,0" Click="OnAskSave" Visibility="Collapsed"/>
          <Button Content="Cancel" Margin="8,0,0,0" Click="OnAskCancel"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AskText" TextWrapping="Wrap"/>
          <TextBlock x:Name="AskHint" Foreground="#8EA088" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="VaultBar" Grid.Row="5" Visibility="Collapsed" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="0,1,0,1" Padding="12,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="VaultYes" Content="Save" Margin="8,0,0,0" Click="OnVaultYes"/>
          <Button x:Name="VaultNever" Content="Never" Margin="8,0,0,0" Click="OnVaultNever"/>
          <Button Content="Not now" Margin="8,0,0,0" Click="OnVaultNotNow"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="VaultText" TextWrapping="Wrap"/>
          <TextBlock x:Name="VaultHint" Foreground="#8EA088" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="CallsColumn" Width="0"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid x:Name="ViewHost"/>
        <Grid x:Name="HomePane" Background="#121611" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Button x:Name="HomeProviderButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"
                  Padding="12,6" Click="OnHomeProvider" Content="Google"/>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,28">
            <TextBlock Text="Search" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <DockPanel Width="520">
              <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Padding="16,0" Click="OnHomeSearch"/>
              <TextBox x:Name="HomeSearch" Height="40" FontFamily="Segoe UI" VerticalContentAlignment="Center" KeyDown="OnHomeSearchKey"/>
            </DockPanel>
            <TextBlock x:Name="HomeNote" Foreground="#8EA088" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Content="Import" Padding="12,4" Click="OnHomeImport"/>
              <Button Content="Export" Margin="8,0,0,0" Padding="12,4" Click="OnHomeExport"/>
            </StackPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="32,8,32,24">
            <WrapPanel x:Name="HomeWrap" HorizontalAlignment="Left"/>
          </ScrollViewer>
          <Border x:Name="HomeEditor" Grid.RowSpan="3" Background="#C0121611" Visibility="Collapsed">
            <Border Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="10" Padding="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel>
                <TextBlock x:Name="HomeEditorTitle" Text="Shortcut" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="Name" Foreground="#8EA088"/>
                <TextBox x:Name="HomeName" Height="32" Margin="0,4,0,8" FontFamily="Segoe UI" VerticalContentAlignment="Center" KeyDown="OnHomeFieldKey"/>
                <TextBlock Text="Address" Foreground="#8EA088"/>
                <TextBox x:Name="HomeUrl" Height="32" Margin="0,4,0,12" FontFamily="Segoe UI" VerticalContentAlignment="Center" KeyDown="OnHomeFieldKey"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Cancel" Padding="12,6" Click="OnHomeCancel"/>
                  <Button Content="Save" Margin="8,0,0,0" Padding="12,6" Click="OnHomeSave"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
        <Grid x:Name="HistoryPane" Background="#121611">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="16,12,16,4">
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearBookmarks" Margin="8,0,0,0"/>
            <TextBlock Text="Bookmarks" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel Grid.Row="1" Margin="16,0,16,8">
            <TextBlock Foreground="#8EA088" TextWrapping="Wrap" Text="Import bookmarks from Chrome, Edge, or Firefox. An address that is not a normal page is still kept."/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Chrome" Tag="chrome" Click="OnImportBrowser" Margin="0,0,8,0"/>
              <Button Content="Edge" Tag="edge" Click="OnImportBrowser" Margin="0,0,8,0"/>
              <Button Content="Firefox" Tag="firefox" Click="OnImportBrowser"/>
            </StackPanel>
            <WrapPanel x:Name="BookmarkImportChoices" Margin="0,8,0,0"/>
            <TextBlock x:Name="BookmarkImportStatus" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <ListBox x:Name="BookmarkList" Grid.Row="2" Margin="16,0,16,8" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnVisitOpen">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0">
                    <Border Background="#273222" CornerRadius="3"/>
                    <TextBlock Text="{Binding Mark}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                  </Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Url}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Row="3" Margin="16,4,16,4">
            <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearHistory" Margin="8,0,0,0"/>
            <TextBlock Text="History" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox x:Name="HistoryList" Grid.Row="4" Margin="16,0,16,12" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnVisitOpen">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="#8EA088" Margin="8,0,0,0"/>
                  <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,2,8,0">
                    <Border Background="#273222" CornerRadius="3"/>
                    <TextBlock Text="{Binding Mark}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Icon}" Width="16" Height="16"/>
                  </Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Url}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border x:Name="HoverChip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,4"
                Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
          <TextBlock x:Name="StatusLeft" Foreground="#E4ECDF" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
      <Border x:Name="CallsPane" Grid.Column="1" Background="#121611" BorderBrush="#2C3828" BorderThickness="1,0,0,0" Padding="12,8,8,8" Visibility="Collapsed">
        <DockPanel>
          <TextBlock x:Name="CallsSummary" DockPanel.Dock="Top" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8" Text="No page open."/>
          <ListBox x:Name="CallList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Band}" FontFamily="Consolas">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#E0C080"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Band}" Value="block">
                              <Setter Property="Foreground" Value="#E0A0A0"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Kind}" Foreground="#8EA088" FontFamily="Consolas" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Host}" FontFamily="Consolas"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Path}" Foreground="#8EA088" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Why}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid x:Name="SettingsPage" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#121611">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0C100B">
          <StackPanel Margin="12,18,12,12">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,14"/>
            <Button x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="General" Tag="general" Click="OnSettingsNav"/>
            <Button x:Name="NavDownloads" Style="{StaticResource NavItem}" Content="Downloads" Tag="downloads" Click="OnSettingsNav"/>
            <Button x:Name="NavVpn" Style="{StaticResource NavItem}" Content="VPN" Tag="vpn" Click="OnSettingsNav"/>
            <Button x:Name="NavPrivacy" Style="{StaticResource NavItem}" Content="Privacy" Tag="privacy" Click="OnSettingsNav"/>
            <Button x:Name="NavPasswords" Style="{StaticResource NavItem}" Content="Passwords" Tag="passwords" Click="OnSettingsNav"/>
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,24,32,32" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel x:Name="PageGeneral">
              <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Home page" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Margin="0,4,0,8" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="The home button and a newly opened window use this page. The built-in page has search and shortcuts."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="HomePage" Content="Built-in page" GroupName="HomeMode" Checked="OnStartChoice"/>
                <RadioButton x:Name="HomeCustom" Content="Custom page" GroupName="HomeMode" Checked="OnStartChoice"/>
              </StackPanel>
              <TextBox x:Name="HomeCustomUrl" Height="32" Margin="0,0,0,4" Visibility="Collapsed" VerticalContentAlignment="Center" LostFocus="OnStartUrl" KeyDown="OnStartUrlKey"/>
              <TextBlock x:Name="HomeCustomNote" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                         Text="Enter an http or https address."/>
              <TextBlock Text="New tab" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock Margin="0,4,0,8" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="A new tab can open the home page, the built-in page, or another address. A page that asks for its own window still opens that page."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="TabHome" Content="Home page" GroupName="TabMode" Checked="OnStartChoice"/>
                <RadioButton x:Name="TabPage" Content="Built-in page" GroupName="TabMode" Checked="OnStartChoice"/>
                <RadioButton x:Name="TabCustom" Content="Custom page" GroupName="TabMode" Checked="OnStartChoice"/>
              </StackPanel>
              <TextBox x:Name="TabCustomUrl" Height="32" Margin="0,0,0,4" Visibility="Collapsed" VerticalContentAlignment="Center" LostFocus="OnStartUrl" KeyDown="OnStartUrlKey"/>
              <TextBlock x:Name="TabCustomNote" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"
                         Text="Enter an http or https address."/>
              <TextBlock Text="Page zoom" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="&#xE71F;" FontFamily="Segoe MDL2 Assets" Width="36" Height="32" Padding="0" ToolTip="Zoom out" Click="OnZoomOut"/>
                <TextBlock x:Name="SettingsZoom" Text="100%" Width="56" VerticalAlignment="Center" TextAlignment="Center" Foreground="#8EA088"/>
                <Button Content="&#xE8A3;" FontFamily="Segoe MDL2 Assets" Width="36" Height="32" Padding="0" ToolTip="Zoom in" Click="OnZoomIn"/>
                <Button Content="Reset" Margin="8,0,0,0" Click="OnZoomReset"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="PageDownloads" Visibility="Collapsed">
              <TextBlock Text="Downloads" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Save files to" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="DownloadFolderText" Margin="0,4,0,8" TextWrapping="Wrap"/>
              <TextBlock Margin="0,0,0,16" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="Files are saved and not opened. Torrent downloads use this folder too."/>
              <TextBlock Text="Magnets and torrent files" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Margin="0,4,0,0" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="A magnet link asks before it opens. A .torrent file asks whether to open it or save it. With the tunnel off, the first open asks for a confirmation, and that choice is kept."/>
            </StackPanel>
            <StackPanel x:Name="PageVpn" Visibility="Collapsed">
              <TextBlock Text="VPN" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock x:Name="TunnelStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Margin="0,0,0,16" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="While the tunnel is on, pages in this window use it only. If it drops, they stop. Chrome and Edge stay on this PC's network. Turn the tunnel off to browse here again."/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TunnelButton" Content="Turn on" MinWidth="108" Click="OnTunnelToggle"/>
                <Button x:Name="ImportButton" Content="Import" Margin="8,0,0,0" Click="OnTunnelImport"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
              <TextBlock Text="Privacy" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Ads and trackers" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="AdStatus" Margin="0,4,0,8" Foreground="#8EA088" TextWrapping="Wrap" Text="Loading filter lists."/>
              <Button x:Name="AdButton" Content="Turn off" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnAdToggle"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton x:Name="AdEasy" Content="Easy" GroupName="AdMode" Checked="OnAdMode"/>
                <RadioButton x:Name="AdMedium" Content="Medium" GroupName="AdMode" Checked="OnAdMode"/>
                <RadioButton x:Name="AdHard" Content="Hard" GroupName="AdMode" Checked="OnAdMode"/>
              </StackPanel>
              <TextBlock Margin="0,0,0,16" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="EasyList, EasyPrivacy, Peter Lowe's ad servers, and a malicious-address list. Easy uses those lists. Medium also blocks third-party scripts and frames. Hard also blocks every other third-party request. Medium and hard break some sites. The page address is not blocked. In-player video ads are skipped. Lists refresh about every four days."/>
              <TextBlock Text="History and bookmarks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Foreground="#8EA088" TextWrapping="Wrap" Text="Import bookmarks from Chrome, Edge, or Firefox. Existing bookmarks stay. An address that is not a normal page is still kept. This browser opens http and https pages."/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Chrome" Tag="chrome" Click="OnImportBrowser" Margin="0,0,8,0"/>
                <Button Content="Edge" Tag="edge" Click="OnImportBrowser" Margin="0,0,8,0"/>
                <Button Content="Firefox" Tag="firefox" Click="OnImportBrowser"/>
              </StackPanel>
              <WrapPanel x:Name="SettingsImportChoices" Margin="0,8,0,0"/>
              <TextBlock x:Name="SettingsImportStatus" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,6,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Clear history" Click="OnClearHistory"/>
                <Button Content="Clear bookmarks" Margin="8,0,0,0" Click="OnClearBookmarks"/>
              </StackPanel>
              <TextBlock Text="Calls" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Margin="0,4,0,8" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="Calls from the open tab are listed. The list does not block them."/>
              <Button Content="Show calls" HorizontalAlignment="Left" Click="OnCallsToggle"/>
            </StackPanel>
            <StackPanel x:Name="PagePasswords" Visibility="Collapsed">
              <TextBlock Text="Passwords" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Margin="0,0,0,12" Foreground="#8EA088" TextWrapping="Wrap"
                         Text="Saved passwords and sign-in cookies are encrypted for this PC. They are loaded only while you are on that site. A copy of them does not open on another computer."/>
              <StackPanel x:Name="PassFilter" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                <RadioButton x:Name="PassAll" Content="All" GroupName="PassView" Checked="OnPassFilter"/>
                <RadioButton x:Name="PassHere" Content="Current page" GroupName="PassView" Checked="OnPassFilter"/>
              </StackPanel>
              <TextBlock x:Name="PassEmpty" Text="No saved passwords." Margin="0,0,0,8" Visibility="Collapsed"/>
              <StackPanel x:Name="PassRows"/>
              <Button x:Name="PassForget" Content="Forget saved sign-ins" HorizontalAlignment="Left" Margin="0,8,0,8" Visibility="Collapsed" Click="OnForgetSignIns"/>
              <Button Content="Import" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnImportPasswords"/>
              <TextBlock x:Name="PassImportNote" Foreground="#8EA088" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

    </Grid>

    <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" HorizontalOffset="-180" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border x:Name="MenuPane" Width="260" Margin="0,6,0,0" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="10" Padding="6">
        <StackPanel>
          <Button Style="{StaticResource MenuItem}" Content="New tab" Click="OnNewTab"/>
          <Button x:Name="ReopenItem" Style="{StaticResource MenuItem}" Content="Reopen closed tab" Click="OnReopen"/>
          <Button Style="{StaticResource MenuItem}" Content="History and bookmarks" Click="OnHistoryToggle"/>
          <Button x:Name="BookBarItem" Style="{StaticResource MenuItem}" Content="Bookmarks bar" Click="OnBookBarToggle"/>
          <Button Style="{StaticResource MenuItem}" Content="Downloads" Click="OnDownloadsToggle"/>
          <Button Style="{StaticResource MenuItem}" Content="Find" Click="OnFindToggle"/>
          <Button Style="{StaticResource MenuItem}" Content="Print" Click="OnPrint"/>
          <Border Height="1" Background="#2C3828" Margin="8,4"/>
          <DockPanel Margin="12,4">
            <TextBlock VerticalAlignment="Center" Text="Zoom"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE71F;" FontSize="12" ToolTip="Zoom out" Click="OnZoomOut"/>
              <TextBlock x:Name="MenuZoom" Width="48" VerticalAlignment="Center" TextAlignment="Center" Foreground="#8EA088" Text="100%"/>
              <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE8A3;" FontSize="12" ToolTip="Zoom in" Click="OnZoomIn"/>
            </StackPanel>
          </DockPanel>
          <Border Height="1" Background="#2C3828" Margin="8,4"/>
          <Button Style="{StaticResource MenuItem}" Content="Calls" Click="OnCallsToggle"/>
          <Button Style="{StaticResource MenuItem}" Content="Protect this sign-in" Click="OnProtectSignIn"/>
          <Button Style="{StaticResource MenuItem}" Content="Forget this sign-in" Click="OnForgetSignIn"/>
          <Button Style="{StaticResource MenuItem}" Content="Settings" Click="OnOpenSettings"/>
        </StackPanel>
      </Border>
    </Popup>

    <Popup x:Name="DownloadsPopup" PlacementTarget="{Binding ElementName=DownloadsButton}" Placement="Bottom" HorizontalOffset="-344" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border x:Name="DownloadPane" Width="380" MaxHeight="460" Margin="0,6,0,0" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="10" Padding="12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE838;" FontSize="14" ToolTip="Open downloads folder" Click="OnOpenDownloadsFolder"/>
            <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <Border x:Name="DownloadAsk" DockPanel.Dock="Top" Visibility="Collapsed" Background="#273222" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open" Margin="8,0,6,0" Padding="10,4" Click="OnApproveOpen"/>
                <Button Content="Cancel" Padding="10,4" Click="OnDeclineOpen"/>
              </StackPanel>
              <TextBlock x:Name="DownloadAskText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <TextBlock x:Name="DownloadEmpty" DockPanel.Dock="Top" Foreground="#8EA088" Text="No downloads"/>
          <ListBox x:Name="DownloadList" BorderThickness="0" Background="Transparent" MaxHeight="340"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0,8,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE838;" FontSize="14"
                            ToolTip="Show in folder" ClickMode="Press" Click="OnShowDownload" Tag="{Binding}" Visibility="{Binding FolderVisibility}"/>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE711;" FontSize="12"
                            ToolTip="Cancel" ClickMode="Press" Click="OnCancelDownload" Tag="{Binding}" Visibility="{Binding CancelVisibility}"/>
                  </StackPanel>
                  <StackPanel>
                    <Button Style="{StaticResource RowButton}" HorizontalAlignment="Stretch" Click="OnOpenDownload" Tag="{Binding}" ToolTip="Open">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Grid Height="3" Margin="0,6,8,4" Background="#333333" Visibility="{Binding BarVisibility}">
                      <Rectangle Fill="#8FB573" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                          <ScaleTransform ScaleX="{Binding Fraction}"/>
                        </Rectangle.RenderTransform>
                      </Rectangle>
                    </Grid>
                    <TextBlock Text="{Binding Detail}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Popup>

    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddressHost}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
      <Border Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MinWidth="360" MaxHeight="320">
        <ListBox x:Name="SuggestList" BorderThickness="0" Background="Transparent" MouseLeftButtonUp="OnSuggestClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,2">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Url}" Foreground="#8EA088" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>

    <Popup x:Name="HomeProviderPopup" PlacementTarget="{Binding ElementName=HomeProviderButton}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
      <Border x:Name="HomeProviderPane" Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="8" Padding="4">
        <StackPanel>
          <Button Style="{StaticResource MenuItem}" Content="Google" Tag="google" Click="OnHomeProviderPick"/>
          <Button Style="{StaticResource MenuItem}" Content="Bing" Tag="bing" Click="OnHomeProviderPick"/>
          <Button Style="{StaticResource MenuItem}" Content="DuckDuckGo" Tag="duckduckgo" Click="OnHomeProviderPick"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
