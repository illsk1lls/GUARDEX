<Window x:Class="Guardex.Uninstall.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GUARDEX Uninstall"
        Width="560" Height="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#121611"
        Foreground="#E4ECDF"
        FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#273222"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#6B3030"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#273222"/>
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="BorderBrush" Value="#2C3828"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E4ECDF"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="#1B2119" BorderBrush="#2C3828" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
              <Grid x:Name="PART_Track" Margin="1">
                <Rectangle x:Name="PART_Indicator" Fill="#8FB573" HorizontalAlignment="Left"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Grid DockPanel.Dock="Top" Height="40" Background="#121611">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Path Width="16" Height="20" Stretch="Fill" Fill="#8FB573" Data="M9,0 L18,3.5 L16.5,12 L9,22 L1.5,12 L0,3.5 Z" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Text="GUARDEX Uninstall" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"/>
      </StackPanel>
    </Grid>
    <StackPanel Margin="22,8,22,18">
      <TextBlock x:Name="Intro" TextWrapping="Wrap" LineHeight="20"/>
      <StackPanel x:Name="Choices">
        <CheckBox x:Name="DataBox" Margin="0,16,0,0">
          <TextBlock TextWrapping="Wrap" MaxWidth="480" Text="Also remove GUARDEX data for this Windows account. The tunnel file, filter lists, browser profile, startup baseline, saved sign-in, and log go with it. Diagnostic settings GUARDEX changed are put back first. Files already saved in Downloads\GUARDEX stay."/>
        </CheckBox>
        <CheckBox x:Name="RulesBox" Margin="0,12,0,0">
          <TextBlock TextWrapping="Wrap" MaxWidth="480" Text="Also remove firewall rules GUARDEX added, including temporary address blocks and the diagnostic program rules."/>
        </CheckBox>
      </StackPanel>
      <ProgressBar x:Name="Bar" Margin="0,18,0,0" Visibility="Collapsed"/>
      <TextBlock x:Name="StepText" Margin="0,12,0,0" Foreground="#8EA088" TextWrapping="Wrap" Text="Ready."/>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove"/>
        <Button x:Name="CancelButton" Content="Cancel" Margin="8,0,0,0" Click="OnClose"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
